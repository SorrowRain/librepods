<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <!-- Heart-rate gating prefs, AirPods proximity keys (IRK/ENC_KEY), the local MAC, serial
         numbers, and raw AACP packet logs must not leave the device via cloud backup or the
         device-to-device transfer on setup. -->
    <cloud-backup>
        <exclude domain="sharedpref" path="heart_rate_private.xml" />
        <exclude domain="sharedpref" path="settings" />
        <exclude domain="sharedpref" path="packet_logs" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="heart_rate_private.xml" />
        <exclude domain="sharedpref" path="settings" />
        <exclude domain="sharedpref" path="packet_logs" />
    </device-transfer>
</data-extraction-rules>
