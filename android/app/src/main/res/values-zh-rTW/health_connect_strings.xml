<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="health_connect_rationale_title">將心率寫入健康資料中心</string>
    <string name="health_connect_rationale_access">只有在你主動開啟匯出並授予寫入權限後，LibrePods 才會寫入心率平均值。應用程式不會請求讀取你的健康資料。</string>
    <string name="health_connect_rationale_frequency">分鐘模式每分鐘寫入一筆平均值；詳細模式每秒寫入一筆平均值。</string>
    <string name="health_connect_rationale_control">關閉匯出後，應用程式會停止接收新樣本、取消待處理工作並丟棄尚未儲存的樣本。你也可以隨時在健康資料中心撤銷權限。</string>
    <string name="health_connect_rationale_storage">心率記錄由本機的健康資料中心儲存和管理。LibrePods 不會上傳這些記錄，也不會將其寫入應用程式日誌。</string>
    <string name="health_connect_rationale_close">關閉</string>
    <string name="health_connect_export_section">健康資料中心</string>
    <string name="health_connect_export_heart_rate">匯出心率</string>
    <string name="health_connect_export_description">此功能可選且預設關閉。只有取得寫入權限後，LibrePods 才會寫入心率平均值，且不會讀取健康資料。</string>
    <string name="health_connect_detailed_samples">詳細樣本</string>
    <string name="health_connect_detailed_samples_description">改為寫入每秒平均值，而不是每分鐘一筆平均值。</string>
    <string name="health_connect_status_unavailable">此裝置無法使用健康資料中心。</string>
    <string name="health_connect_status_update_required">需要先更新健康資料中心才能啟用匯出。</string>
    <string name="health_connect_status_permission_required">需要心率寫入權限。</string>
    <string name="health_connect_status_permission_denied">未授予心率寫入權限。</string>
    <string name="health_connect_status_ready">已授予寫入權限，匯出仍為關閉狀態。</string>
    <string name="health_connect_status_enabled">心率匯出已開啟。</string>
    <string name="health_connect_status_error">健康資料中心暫時無法使用，匯出將自動重試。</string>
</resources>
